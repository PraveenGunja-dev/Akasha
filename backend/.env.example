# Chat model router. Change only MODEL_PROVIDER to swap the primary and fallback order.
MODEL_PROVIDER=openrouter
MODEL_FALLBACK_PROVIDER=auto

OPENROUTER_API_KEY=<YOUR_OPENROUTER_KEY>
OPENROUTER_MODEL=<TOOL_CAPABLE_OPENROUTER_MODEL_ID>
OPENROUTER_VISION_MODEL=<VISION_AND_TOOL_CAPABLE_OPENROUTER_MODEL_ID>
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_APP_URL=http://localhost:5173/akasha/
OPENROUTER_APP_NAME=Akasha

OPENAI_API_KEY=<YOUR_OPENAI_KEY>
OPENAI_MODEL=gpt-5.6-luna
# Responses API reasoning effort: none, low, medium, high, xhigh, or max.
OPENAI_REASONING_EFFORT=medium
# GPT-5.6 Luna supports vision, so the same model can serve image requests.
OPENAI_VISION_MODEL=gpt-5.6-luna

# Shared runtime tuning.
AKASHA_MODEL_OUTPUT_TOKENS=5000
AKASHA_MODEL_MAX_RETRIES=3
AKASHA_MODEL_TIMEOUT_SECONDS=300
AKASHA_MODEL_CONNECT_TIMEOUT_SECONDS=60
