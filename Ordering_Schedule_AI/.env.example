# Copy to .env (git-ignored) and fill in. The explanation layer falls back to
# a deterministic template when no provider is configured or a call fails.

# Which LLM writes the explanation: azure | groq | none
AI_PROVIDER=azure

# Groq (local development)
AKASHA_AI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Azure OpenAI (VM)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2023-05-15

# --- ai_governance2.py: ANTHROPIC (Claude Sonnet) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium

# --- ai_governance2.py: OPENROUTER (default provider) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
